generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Amphures {
  id          Decimal    @id(map: "amphures_pkey") @db.Decimal
  name_th     String?
  name_en     String?
  province_id Decimal?   @db.Decimal
  Provinces   Provinces? @relation(fields: [province_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_amphures_province")
}

model Provinces {
  id           Decimal    @id(map: "provinces_pkey") @db.Decimal
  name_th      String?
  name_en      String?
  geography_id Decimal?   @db.Decimal
  Amphures     Amphures[]
  Region       Region?    @relation(fields: [geography_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "provinces_geography_id_fkey")
}

model Region {
  id        Decimal     @id(map: "Regรนื_pkey") @db.Decimal
  name_thai String?
  name_en   String?
  Provinces Provinces[]
}

model Tambons {
  id         Decimal  @id(map: "tambons_pkey") @db.Decimal
  zip_code   Decimal? @db.Decimal
  name_th    String?
  name_en    String?
  amphure_id Decimal? @db.Decimal
}

model Users {
  id        Decimal  @id @db.Decimal
  email     String   @unique
  username  String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime
}
